// =============================================================================
// WMS 360+ FORMATEX — Prisma Schema v2
// Distribuidora de Tela al Mayoreo — Formatextil S. de R.L. de C.V.
// HU-Céntrico | Corte + Genealogía | FIFO | Reservas Blanda/Firme
// Inventario en Tránsito | 9 Estados de Pedido | Flujo Real Formatex
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// =============================================================================
// GRUPO 1: ALMACÉN FÍSICO
// =============================================================================

model Warehouse {
  id             String   @id @default(uuid())
  nombre         String   // "Nave Formatex"
  codigo         String   @unique // "NAV-001"
  tipo           String   @default("FISICO") // "FISICO" | "VIRTUAL"
  direccion      String?
  metrosCuad     Float?   @default(1000)
  clienteAsignado String? // Para bodegas virtuales - nombre del cliente
  descripcion    String?
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  zones          Zone[]
  locations      Location[]
  mermaRanges    MermaRangeConfig[]
  transfersOrigen  Transfer[] @relation("TransferOrigen")
  transfersDestino Transfer[] @relation("TransferDestino")
}

model Zone {
  id           String   @id @default(uuid())
  warehouseId  String
  nombre       String   // "Rollos Enteros 1", "Merma 1-5m", "Corte", "Empaque"
  codigo       String   @unique // "RE-01", "MER-01", "CORTE", "EMPAQUE"
  tipo         ZoneType @default(ROLLOS_ENTEROS)
  descripcion  String?
  orden        Int      @default(0)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  warehouse    Warehouse  @relation(fields: [warehouseId], references: [id])
  locations    Location[]

  @@index([warehouseId])
}

enum ZoneType {
  ROLLOS_ENTEROS
  MERMA
  RECIBO
  CORTE
  EMPAQUE
  EMBARQUE
}

model Location {
  id           String         @id @default(uuid())
  warehouseId  String
  zoneId       String
  codigo       String         @unique // "RE01-P01-R01-N1", "MER01-P01-R01"
  pasillo      String         // "P01"
  rack         String?        // "R01"
  nivel        String?        // "N1"
  tipo         LocationType   @default(RACK)
  estado       LocationStatus @default(LIBRE)
  capacidad    Int            @default(1)   // Cuántos HUs caben
  activo       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id])
  zone         Zone           @relation(fields: [zoneId], references: [id])
  handlingUnits HandlingUnit[]

  @@index([warehouseId])
  @@index([zoneId])
  @@index([estado])
}

enum LocationType {
  RACK
  PISO
  STAGING    // Área temporal (corte, empaque)
  MUELLE     // Muelle de carga/descarga
}

enum LocationStatus {
  LIBRE
  PARCIAL
  OCUPADA
  BLOQUEADA
}

// =============================================================================
// GRUPO 2: CONFIGURACIÓN DE MERMA (Rangos configurables)
// =============================================================================

model MermaRangeConfig {
  id            String   @id @default(uuid())
  warehouseId   String
  nombre        String   // "Retazos 1-5m"
  minMetros     Float    // 1
  maxMetros     Float    // 5
  zonaCodigo    String   // Código de la zona asignada "MER-01"
  pasillo       String   // "MERMA-P01"
  orden         Int      @default(0)
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, minMetros, maxMetros])
  @@index([warehouseId])
}

// =============================================================================
// GRUPO 3: CATÁLOGOS
// =============================================================================

model SkuMaster {
  id               String   @id @default(uuid())
  codigo           String   @unique // "LENIGIRO" (clave real de Formatex)
  nombre           String   // "Enigma Iron"
  descripcion      String?
  categoria        String?  // "Lino", "Algodón", "Poliéster", "Mezcla"
  composicion      String?  // "100% algodón"
  anchoMetros      Float?   // 1.5m (ancho del rollo — igual para todos)
  color            String?
  pesoKgPorMetro   Float?   // Peso por metro lineal
  metrajeEstandar  Float    @default(50) // Metraje de rollo nuevo (50m)
  unidadMedida     String   @default("MTR") // MTR = metros (como en el pedido real)
  codigoBarras     String?  @unique
  minStock         Float?   // Stock mínimo en metros
  maxStock         Float?
  precioReferencia Decimal? @db.Decimal(10, 2) // Precio referencia por metro
  supplierId       String?
  libroColeccion   String?  // Colección / Libro asignado (ej. "LIBRO AMALFI", "CASSIS")
  tipoArticulo     String   @default("TELA") // "TELA" | "MUESTRARIO"
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  costoOrigenUSD   Decimal? @db.Decimal(10, 2) // Precio FOB en origen (USD)
  costoPuestoMexicoMXN Decimal? @db.Decimal(10, 2) // Landed Cost puesto en bodega (MXN)
  codigoChina      String?  // Código técnico del proveedor en China
  nombreChino      String?  // Nombre técnico del proveedor en China
  fabrica          String?  // Nombre de la fábrica textil en China (ej. MMD, KAAN)
  semanasLeadTime  Int?     @default(4) // Semanas estimadas de producción y entrega

  supplier         Supplier?      @relation(fields: [supplierId], references: [id])
  handlingUnits    HandlingUnit[]
  incomingShipmentLines IncomingShipmentLine[]
  supplyPlanLines  SupplyPlanLine[]
  reorderConfig    ReorderConfig?
  purchaseOrderLines PurchaseOrderLine[] @relation("SkuPurchaseOrderLines")
  supplierPrices   SupplierPrice[]      @relation("SkuSupplierPrices")
  salesHistory     SkuSalesHistory[]
  specialPrices    ClientSpecialPrice[]
  priceLists       SkuPriceList[]

  @@index([categoria])
  @@index([color])
  @@index([libroColeccion])
  @@index([tipoArticulo])
}

model Supplier {
  id           String   @id @default(uuid())
  nombre       String
  codigo       String   @unique
  contacto     String?
  telefono     String?
  email        String?
  direccion    String?
  rfc          String?
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  skus               SkuMaster[]
  purchaseReceipts   PurchaseReceipt[]
  incomingShipments  IncomingShipment[]
  supplyPlanLines    SupplyPlanLine[]
  purchaseOrders     PurchaseOrder[]   @relation("SupplierPurchaseOrders")
  supplierPrices     SupplierPrice[]   @relation("SupplierPrices")
}

model Client {
  id                 String   @id @default(uuid())
  nombre             String
  codigo             String   @unique
  contacto           String?
  telefono           String?
  email              String?
  direccion          String?
  colonia            String?
  poblacion          String?
  estado             String?
  cp                 String?
  pais               String?  @default("México")
  rfc                String?
  regimenFiscal       String?  // Clave SAT: "601", "612", "616", etc.
  usoCfdi             String?  @default("G03") // Uso CFDI default del cliente
  tipoCliente         String?  // "PG", "CD", "T", "XT", "F", "XF", "D", "P", "CE"
  vendorId           String?  // Vendedor que trajo este cliente
  listaPrecioDefault String?  @default("F1") // "F1" Casa Decoradora, "F2" Tienda, etc.
  cartaFletera       String?  // Fletera habitual por carta: "Castores", "Tres Guerras", "Paquetexpress", "Local"
  seguroEnvioDefault Boolean  @default(false)
  activo             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  vendor             Vendor?  @relation(fields: [vendorId], references: [id])
  orders             Order[]
  creditConfig       ClientCreditConfig?
  addresses          ClientAddress[]
  specialPrices      ClientSpecialPrice[]

  @@index([vendorId])
  @@index([listaPrecioDefault])
}

model ClientAddress {
  id               String   @id @default(uuid())
  clientId         String
  alias            String   // "Matriz Fiscal", "Bodega Zapopan", "Taller Tapicería Punto Sur"
  tipo             String   @default("ENTREGA") // "FISCAL" | "ENTREGA" | "AMBOS"
  calleNumero      String
  colonia          String?
  municipio        String?  // Municipio / Alcaldía
  estado           String?  @default("Jalisco")
  cp               String?
  pais             String?  @default("México")
  contactoNombre   String?  // Nombre de quien recibe
  contactoTelefono String?  // Teléfono del receptor (chofer llama antes)
  horarioRecepcion String?  // Ej: "Lunes a Viernes 08:00 a 14:00"
  referencias      String?  // Indicaciones para el chofer / fletera
  esPredeterminada Boolean  @default(false)
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  orders           Order[]

  @@index([clientId])
  @@index([tipo])
}

model ClientSpecialPrice {
  id                 String   @id @default(uuid())
  clientId           String
  skuId              String
  precioPactado      Decimal  @db.Decimal(10, 2) // Precio neto pactado por metro (autorizado por Dirección)
  referenciaProyecto String?  // "Proyecto Cadena Plasencia", "Licitación Liverpool", etc.
  autorizadoPor      String?  // Nombre / userId de Dirección General / Ricardo
  notas              String?
  vigenteDesde       DateTime @default(now())
  vigenteHasta       DateTime?
  activo             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sku                SkuMaster @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([clientId, skuId])
  @@index([clientId])
  @@index([skuId])
}

model Vendor {
  id           String   @id @default(uuid())
  nombre       String
  codigo       String   @unique
  telefono     String?
  email        String?
  comision     Decimal? @db.Decimal(5, 2) // Porcentaje de comisión
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clients      Client[]
  orders       Order[]  // Vendedor callejero que trajo el pedido
}

// =============================================================================
// GRUPO 4: INVENTARIO (HU-Céntrico) ⭐
// =============================================================================

model HandlingUnit {
  id                String       @id @default(uuid())
  codigo            String       @unique // HU-2026-00001
  skuId             String

  // === METRAJE ===
  metrajeOriginal   Float        // Metraje al crear este HU (50m si nuevo, 40m si retazo)
  metrajeActual     Float        // Metraje disponible ahora
  anchoMetros       Float?       // Ancho del rollo
  pesoKg            Float?

  // === CLASIFICACIÓN ===
  tipoRollo         RollType     @default(ENTERO)
  estadoHu          HuStatus     @default(DISPONIBLE)
  gradoCalidad      String       @default("PRIMERA") // "PRIMERA" | "CALIDAD_A" | "CALIDAD_B" | "CALIDAD_C" | "CALIDAD_D" | "RESTRINGIDO"
  calidadRestringida Boolean     @default(false)     // True = no disponible para venta regular (apartado/bloqueado)

  // === UBICACIÓN ===
  ubicacionId       String?

  // === GENEALOGÍA (Trazabilidad de cortes) ===
  parentHuId        String?      // HU padre (null si rollo nuevo de pallet)
  generacion        Int          @default(0) // 0=original, 1=primer corte, 2=segundo...

  // === RECEPCIÓN ===
  receiptLineId     String?
  palletId          String?      // Identificador del pallet de origen
  loteProveedor     String?      // Lote del proveedor (opcional)

  // === FIFO ===
  fechaIngreso      DateTime     @default(now())

  // === ETIQUETADO ===
  etiquetaImpresa   Boolean      @default(false)
  fechaEtiquetado   DateTime?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // === RELACIONES ===
  sku               SkuMaster    @relation(fields: [skuId], references: [id])
  ubicacion         Location?    @relation(fields: [ubicacionId], references: [id])
  parentHu          HandlingUnit?  @relation("HuGenealogy", fields: [parentHuId], references: [id])
  childHus          HandlingUnit[] @relation("HuGenealogy")
  receiptLine       PurchaseReceiptLine? @relation(fields: [receiptLineId], references: [id])

  cortesOrigen      CutOperation[]       @relation("CutSource")
  cortesRetazo      CutOperation[]       @relation("CutRemnant")
  movimientos       InventoryMovement[]
  orderAssignments  OrderLineAssignment[]
  reservations      Reservation[]
  transferLines     TransferLine[]

  @@index([skuId])
  @@index([ubicacionId])
  @@index([tipoRollo])
  @@index([estadoHu])
  @@index([fechaIngreso]) // Para FIFO
  @@index([parentHuId])
  @@index([gradoCalidad])
}

enum RollType {
  ENTERO
  RETAZO
}

enum HuStatus {
  DISPONIBLE
  RESERVADO_BLANDO     // Reserva de cotización (24h, auto-expira)
  RESERVADO            // Reserva firme (cliente aprobó)
  EN_PICKING
  EN_CORTE
  EN_EMPAQUE
  DESPACHADO
  AGOTADO
  DANADO
}

model InventoryMovement {
  id            String       @id @default(uuid())
  huId          String
  tipo          MovementType
  metrajeAntes  Float?
  metrajeDespues Float?
  ubicacionOrigen  String?
  ubicacionDestino String?
  referencia    String?      // Código de receipt, order, cut, etc.
  notas         String?
  userId        String
  createdAt     DateTime     @default(now())

  hu            HandlingUnit @relation(fields: [huId], references: [id])
  user          User         @relation(fields: [userId], references: [id])

  @@index([huId])
  @@index([tipo])
  @@index([createdAt])
}

enum MovementType {
  ENTRADA
  SALIDA
  CORTE
  REUBICACION
  AJUSTE
  CONTEO
  RESERVA
  TRANSFERENCIA
}

// =============================================================================
// GRUPO 4B: SISTEMA DE RESERVAS ⭐ (Mata la doble-venta)
// =============================================================================

model Reservation {
  id              String          @id @default(uuid())
  orderId         String?         // Pedido asociado
  orderLineId     String?         // Línea específica del pedido
  huId            String?         // HU físico reservado
  shipmentLineId  String?         // Línea de embarque en tránsito (null si es stock físico)
  skuId           String          // SKU de la tela
  metrajeReservado Float          // Metros reservados
  tipo            ReservationType // BLANDA (24h) o FIRME
  estado          ReservationStatus @default(ACTIVA)
  motivoCancelacion String?
  expiresAt       DateTime?       // Para reservas blandas — auto expira
  creadoPor       String          // userId del ATC
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  order           Order?          @relation(fields: [orderId], references: [id])
  hu              HandlingUnit?   @relation(fields: [huId], references: [id])
  shipmentLine    IncomingShipmentLine? @relation(fields: [shipmentLineId], references: [id])

  @@index([orderId])
  @@index([huId])
  @@index([skuId])
  @@index([estado])
  @@index([expiresAt])
}

enum ReservationType {
  BLANDA  // Cotización — expira en 24h
  FIRME   // Cliente aprobó — no expira
}

enum ReservationStatus {
  ACTIVA
  CONVERTIDA   // Blanda → Firme
  EXPIRADA     // Auto-expiró (24h)
  CANCELADA    // Cancelación manual
  SURTIDA      // Pedido despachado
}

// =============================================================================
// GRUPO 4C: INVENTARIO EN TRÁNSITO ⭐ (Ordenes de compra entrantes)
// =============================================================================

model IncomingShipment {
  id              String              @id @default(uuid())
  codigo          String              @unique // EMB-2026-0001
  supplierId      String
  ordenCompra     String?             // Referencia OC del proveedor
  estado          IncomingShipmentStatus @default(EN_TRANSITO)
  fechaEstimada   DateTime            // ETA — Fecha estimada de llegada
  fechaReal       DateTime?           // Fecha real de llegada
  transportista   String?
  numeroContenedor String?             // Identificador oficial del contenedor (ej: MSCU-829104-1)
  numeroPedimento String?             // Pedimento SAT oficial (ej: 26 16 1924 6003496)
  fechaPagoPedimento DateTime?        // Fecha de liquidación bancaria del pedimento
  tipoCambioPedimento Decimal?        @db.Decimal(10, 4) // TC oficial con el que se desaduanó
  aduanaDespacho  String?             // "Manzanillo 16", etc.
  fleteInternacionalMXN Decimal?      @db.Decimal(12, 2)
  seguroCargaMXN  Decimal?            @db.Decimal(12, 2)
  gastosIncrementablesPct Decimal?    @db.Decimal(5, 2) // % gastos incrementables (ej: 23%)
  notas           String?
  receiptId       String?             // Recepción generada al llegar
  creadoPor       String              // userId
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  supplier        Supplier            @relation(fields: [supplierId], references: [id])
  lineas          IncomingShipmentLine[]
  orders          Order[]             // Pedidos en backorder vinculados a este embarque

  @@index([supplierId])
  @@index([estado])
  @@index([fechaEstimada])
  @@index([numeroContenedor])
}

model IncomingShipmentLine {
  id              String   @id @default(uuid())
  shipmentId      String
  skuId           String
  cantidadRollos  Int      // Rollos esperados
  metrajePorRollo Float    @default(50)
  metrajeTotal    Float    // Total metros esperados
  metrajeReservado Float   @default(0) // Metros ya reservados de este embarque
  notas           String?
  createdAt       DateTime @default(now())

  shipment        IncomingShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  sku             SkuMaster        @relation(fields: [skuId], references: [id])
  reservations    Reservation[]

  @@index([shipmentId])
  @@index([skuId])
}

enum IncomingShipmentStatus {
  EN_TRANSITO
  PARCIAL       // Llegó parcialmente
  RECIBIDO      // Todo recibido
  CANCELADO
}

// =============================================================================
// GRUPO 5: RECEPCIÓN
// =============================================================================

model PurchaseReceipt {
  id            String        @id @default(uuid())
  codigo        String        @unique // REC-2026-0001
  supplierId    String
  fechaRecepcion DateTime     @default(now())
  estado        ReceiptStatus @default(PENDIENTE)
  totalPallets  Int           @default(0)
  totalRollos   Int           @default(0)
  transportista String?
  placas        String?
  ordenCompra   String?       // Referencia a OC en CONTPAQi
  shipmentRef   String?       // ID del IncomingShipment si viene de tránsito
  notas         String?
  recibidoPor   String        // userId
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  lineas        PurchaseReceiptLine[]

  @@index([supplierId])
  @@index([estado])
}

model PurchaseReceiptLine {
  id             String   @id @default(uuid())
  receiptId      String
  skuId          String
  cantidadRollos Int      // Cuántos rollos de este SKU
  metrajePorRollo Float   @default(50) // Metraje de cada rollo
  metrajeTotalRecibido Float // cantidadRollos * metrajePorRollo
  palletRef      String?  // Referencia del pallet
  createdAt      DateTime @default(now())

  receipt        PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  handlingUnits  HandlingUnit[]

  @@index([receiptId])
}

enum ReceiptStatus {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
  CANCELADA
}

// =============================================================================
// GRUPO 6: PEDIDOS Y DESPACHO ⭐ (Flujo real Formatex — 9 estados)
// =============================================================================

model Order {
  id              String      @id @default(uuid())
  codigo          String      @unique // PED-2026-0001
  folioContpaqi   String?     // Folio del pedido en CONTPAQi (PE XXXXXX)
  clientId        String
  vendorId        String?     // Vendedor callejero que trajo el pedido
  atcUserId       String?     // ATC que levantó el pedido en sistema
  estado          OrderStatus @default(COTIZADO)
  prioridad       Int         @default(3) // 1=urgente, 5=baja
  tolerancia      Float       @default(20) // Tolerancia ±20% en el surtido

  // === FECHAS ===
  fechaPedido     DateTime    @default(now())
  fechaRequerida  DateTime?
  fechaCotizacion DateTime?   // Cuando se envió la cotización
  fechaPago       DateTime?   // Cuando el cliente pagó
  fechaAprobCobranza DateTime? // Cuando cobranza aprobó
  cobradorNombre     String?   // Nombre de quien validó en cobranza
  cobranzaNotas      String?   // Notas del cobrador
  cobranzaEvidencia  String?   // URL de evidencia de pago

  // === FINANCIERO ===
  subtotal        Decimal?    @db.Decimal(12, 2)
  descuento       Decimal?    @db.Decimal(12, 2) @default(0)
  iva             Decimal?    @db.Decimal(12, 2)
  total           Decimal?    @db.Decimal(12, 2)
  metodoPago      String?     // "Banco Bancomer", "Transferencia", etc.
  referenciaPago  String?     // Número de referencia del pago
  comprobantePago String?     // URL/path del comprobante subido

  // === FACTURACIÓN CFDI (Facturapi) ===
  facturaRef      String?     // Referencia legacy CONTPAQi
  facturaLista    Boolean     @default(false)
  facturapiId     String?     // ID de la factura en Facturapi
  uuidFiscal      String?     // UUID del CFDI (folio fiscal SAT)
  facturaSerie    String?     // Serie de la factura (ej: "A")
  facturaFolio    String?     // Folio consecutivo
  facturaXmlUrl   String?     // URL de descarga XML
  facturaPdfUrl   String?     // URL de descarga PDF
  facturaStatus   String?     // "valid", "canceled"
  facturadaAt     DateTime?   // Fecha/hora de timbrado

  // === CRÉDITO / PPD ===
  metodoPagoCfdi  String      @default("PUE") // PUE o PPD
  condicionesPago String?     // "Crédito 30 días", "Crédito 60 días"
  plazoDias       Int?        // 30, 60, 90
  saldoPendiente  Decimal?    @db.Decimal(12, 2) // Saldo por cobrar (null si PUE)
  estadoPago      String      @default("NA") // NA (PUE), PENDIENTE, PARCIAL, PAGADA
  fechaVencimiento DateTime?  // Fecha límite de pago

  // === OPERATIVO ===
  requiereCorte        Boolean        @default(true)
  reservaHoras         Int            @default(72)  // Apartado interno almacén: 72h (3 días) / 24h comercial al cliente
  modoEntrega          String         @default("COMPLETA")  // COMPLETA (esperar todo) o PARCIAL (entregas separadas)
  transportista        String?
  guiaEnvio            String?
  notas                String?
  condiciones          String?

  // === LOGÍSTICA DE ENTREGA (Confirmación en Surtido) ===
  deliveryAddressId    String?        // Dirección de entrega específica (ClientAddress)
  deliveryContactName  String?        // Persona que recibe en destino
  deliveryContactPhone String?        // Teléfono del receptor (chofer/fletera llama antes)
  deliverySchedule     String?        // Horarios de recepción (ej: "L-V 9:00 - 14:00")
  fletera              String?        // Fletera seleccionada por carta (Castores, Tres Guerras, Paquetexpress, Chofer Formatex)
  envioAsegurado       Boolean        @default(false) // Si el cliente autorizó seguro de mercancía
  deliveryConfirmed    Boolean        @default(false) // ATC confirmó datos de entrega durante el surtido
  deliveryConfirmedAt  DateTime?      // Fecha/hora de confirmación
  deliveryConfirmedBy  String?        // userId de ATC o Alma (supervisora)

  // === GOBERNANZA Y AUTORIZACIONES (Precios Especiales / Cambio de Lista) ===
  approvalStatus       String         @default("NO_REQUIERE") // "NO_REQUIERE" | "PENDIENTE" | "APROBADO" | "RECHAZADO"
  approvalReason       String?        // Motivo: "Precio especial fuera de lista", "Lista F5 asignada", etc.
  approvedBy           String?        // userId de Gerencia / Alma / Dirección
  approvedAt           DateTime?

  // === BACKORDER & SEGUIMIENTO DE CONTENEDORES ⭐ ===
  esBackorder                  Boolean        @default(false)
  backorderStatus              String?        // "EN_COLA" | "NOTIFICADO_15D" | "NOTIFICADO_5D" | "CONFIRMADO" | "REASIGNADO" | "CANCELADO"
  condicionBackorder           String?        // "CONTADO_ANTICIPO" | "CONTADO_AL_ARRIBO" | "CREDITO"
  contenedorNumero             String?        // ej: "MSCU-829104-1"
  fechaEstimadaArriboContenedor DateTime?     // ETA del contenedor
  posicionCola                 Int?           // 1, 2, 3... orden cronológico en lista de espera (FIFO)
  incomingShipmentId           String?        // Embarque en tránsito vinculado
  notificado15DiasAt           DateTime?      // Fecha en que se notificó la alerta preventiva de 15 días
  notificado5DiasAt            DateTime?      // Fecha en que se notificó la alerta urgente de 5 días
  vigenciaConfirmadaAt         DateTime?      // Fecha en que el cliente confirmó vigencia de su orden de compra
  vigenciaConfirmadaPor        String?        // Ejecutivo ATC o Supervisora que confirmó vigencia

  // === OPERATIVO & ALMACÉN (Entrevista Israel / Oct 2026) ===
  tiempoPromesaSlaHoras        Int?           @default(72) // 48 (rollo cerrado <10), 72 (1-4 cortes), 96 (5-9 cortes o acumulado)
  fechaPromesaEntrega          DateTime?      // Fecha límite calculada en días hábiles
  validacionFisicaRequerida    Boolean        @default(false) // Stock <100m en almacén dispara revisión física
  validacionFisicaEstatus      String?        // "PENDIENTE" | "CONFIRMADO_VISUAL" | "CONFIRMADO_MESA" | "RECHAZADO"
  metrajeConfirmadoFisico      Float?         // Metraje verificado en rollo o medido en mesa
  validacionFisicaNotas        String?
  alertaVariacionTono          Boolean        @default(false) // Mezcla de lotes detectada en surtido
  variacionTonoAceptada        Boolean        @default(false) // Autorización del cliente para mezclar lotes
  variacionTonoAceptadaPor     String?        // Nombre de quien autorizó en ATC
  carritoCorte                 String?        // Ej: "Carrito 01 - A1", "Carrito 02 - A3" (3 niveles A1, A2, A3)
  tipoEtiquetaEmbarque         String?        // "LOCAL_INFERIOR" | "FORANEO_SUPERIOR" | "OCOTLAN" | "PAQUETERIA"

  // === ASIGNACIÓN Y DESPACHO DE SURTIDO (Torre de Control Israel) ===
  surtidorId                   String?        // ID del surtidor asignado
  surtidorNombre               String?        // Nombre del surtidor asignado
  asignadoPor                  String?        // ID de quien asignó (Israel / Coordinador)
  fechaAsignacion              DateTime?      // Fecha/hora en que Israel despachó el pedido
  tipoPicking                  String?        @default("SOLO_PISO") // "SOLO_PISO" | "REQUIERE_MONTACARGAS" | "MIXTO"

  creadoPor            String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  client               Client         @relation(fields: [clientId], references: [id])
  deliveryAddress      ClientAddress? @relation(fields: [deliveryAddressId], references: [id])
  vendor               Vendor?        @relation(fields: [vendorId], references: [id])
  incomingShipment     IncomingShipment? @relation(fields: [incomingShipmentId], references: [id])
  lineas               OrderLine[]
  packingSlips         PackingSlip[]
  shipments            Shipment[]
  reservations         Reservation[]
  payments             InvoicePayment[]

  @@index([clientId])
  @@index([deliveryAddressId])
  @@index([approvalStatus])
  @@index([vendorId])
  @@index([estado])
  @@index([fechaPedido])
  @@index([folioContpaqi])
  @@index([estadoPago])
  @@index([esBackorder])
  @@index([incomingShipmentId])
  @@index([contenedorNumero])
  @@index([backorderStatus])
  @@index([surtidorId])
  @@index([tipoPicking])
}

enum OrderStatus {
  // === VENTAS / ATC ===
  COTIZADO              // ATC envió cotización al cliente (reserva BLANDA 24h)
  POR_PAGAR             // Cliente aprobó cotización, esperando pago (reserva FIRME)

  // === COBRANZA ===
  PAGO_RECIBIDO         // Comprobante recibido por WA/email, pendiente verificación
  POR_SURTIR            // Cobranza verificó pago vs banco, firmó → pasa a almacén

  // === ALMACÉN ===
  EN_SURTIDO            // Picker tomó el pedido y está buscando rollos
  EN_CORTE              // En estación de corte (cortador procesando)
  EMPACADO              // Embalado, listo para facturar

  // === FACTURACIÓN / DESPACHO ===
  FACTURADO             // Factura emitida en CONTPAQi
  DESPACHADO            // Salió del almacén

  // === OTROS ===
  CANCELADO
}

model OrderLine {
  id             String   @id @default(uuid())
  orderId        String
  skuId          String
  metrajeRequerido Float  // Metros que pidió el cliente (ej: 100m)
  metrajeSurtido   Float  @default(0)  // Metros efectivamente cortados/surtidos
  precioUnitario Decimal? @db.Decimal(10, 2) // Precio por metro (ej: $107.28)
  importe        Decimal? @db.Decimal(12, 2) // metrajeRequerido * precioUnitario

  // === LISTA DE PRECIOS Y COMISIÓN ===
  listaPrecios   String?  // "F1", "F2", "F3", "F4", "F5"
  precioLista    Decimal? @db.Decimal(10, 2) // Precio original de lista antes de descuento
  descuentoPct   Decimal? @db.Decimal(5, 2) @default(0) // % descuento aplicado en esta línea
  comisionPct    Decimal? @db.Decimal(5, 2)  // % comisión del vendedor según lista

  requiereCorte  Boolean  @default(true)
  estado         String   @default("PENDIENTE") // PENDIENTE, EN_PROCESO, SURTIDA, CANCELADA
  notas          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignments    OrderLineAssignment[]
  cutOperations  CutOperation[]

  @@index([orderId])
}

// Permite combinar múltiples HUs para surtir una línea (ej: 65m + 41m = 106m)
model OrderLineAssignment {
  id             String   @id @default(uuid())
  orderLineId    String
  huId           String
  metrajeTomado  Float    // Metros tomados de este HU
  requiereCorte  Boolean  @default(true)
  cortado        Boolean  @default(false)
  createdAt      DateTime @default(now())

  orderLine      OrderLine    @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  hu             HandlingUnit @relation(fields: [huId], references: [id])

  @@index([orderLineId])
  @@index([huId])
}

// =============================================================================
// GRUPO 7: CORTE ⭐ (Core del sistema)
// =============================================================================

model CutOperation {
  id                String   @id @default(uuid())
  codigo            String   @unique // COR-2026-00001
  huOrigenId        String
  orderLineId       String?

  // === METRAJE ===
  metrajeAntes      Float    // Metraje del HU antes del corte
  metrajeCortado    Float    // Metros cortados para el pedido
  metrajeRestante   Float    // Lo que queda (retazo)

  // === RETAZO GENERADO ===
  huRetazoId        String?  @unique // Nuevo HU del retazo (null si se agotó el rollo)
  retazoUbicacion   String?  // A dónde fue el retazo (código de ubicación)

  // === OPERADOR ===
  cortadoPor        String   // userId
  fechaCorte        DateTime @default(now())
  notas             String?

  createdAt         DateTime @default(now())

  huOrigen          HandlingUnit  @relation("CutSource", fields: [huOrigenId], references: [id])
  huRetazo          HandlingUnit? @relation("CutRemnant", fields: [huRetazoId], references: [id])
  orderLine         OrderLine?    @relation(fields: [orderLineId], references: [id])

  @@index([huOrigenId])
  @@index([fechaCorte])
}

// =============================================================================
// GRUPO 8: FULFILLMENT
// =============================================================================

model PackingSlip {
  id            String   @id @default(uuid())
  codigo        String   @unique // PAK-2026-0001
  orderId       String
  bultos        Int      @default(1)
  pesoTotalKg   Float?
  empacadoPor   String   // userId
  fechaEmpaque  DateTime @default(now())
  notas         String?
  createdAt     DateTime @default(now())

  order         Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model Shipment {
  id            String         @id @default(uuid())
  codigo        String         @unique // ENV-2026-0001
  orderId       String
  transportista String?
  guiaEnvio     String?
  placas        String?
  chofer        String?
  estado        ShipmentStatus @default(PENDIENTE)
  fechaEnvio    DateTime?
  fechaEntrega  DateTime?
  enviadoPor    String         // userId
  notas         String?

  // === EMBARQUES & FLETERAS (Entrevista Israel / Oct 2026) ===
  labelType           String?        // "LOCAL_INFERIOR" | "FORANEO_SUPERIOR" | "OCOTLAN" | "PAQUETERIA"
  evidenciaFotoUrl    String?        // Fotografía del acuse de recibo / guía sellada por fletera
  pesoKg              Decimal?       @db.Decimal(8, 2) // Requerido para Paquetexpress
  largoCm             Decimal?       @db.Decimal(8, 2)
  anchoCm             Decimal?       @db.Decimal(8, 2)
  altoCm              Decimal?       @db.Decimal(8, 2)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  order         Order          @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([estado])
}

enum ShipmentStatus {
  PENDIENTE
  EN_TRANSITO
  ENTREGADO
  DEVUELTO
}

// =============================================================================
// GRUPO 9: ALERTAS Y TAREAS
// =============================================================================

model Alert {
  id          String    @id @default(uuid())
  tipo        AlertType
  titulo      String
  mensaje     String
  severidad   String    @default("MEDIA") // BAJA, MEDIA, ALTA, CRITICA
  resuelta    Boolean   @default(false)
  resueltaPor String?
  resueltaAt  DateTime?
  metadata    Json?     // Datos adicionales (skuId, huId, etc.)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks       Task[]

  @@index([tipo])
  @@index([resuelta])
}

enum AlertType {
  STOCK_BAJO
  RETAZO_SIN_UBICAR
  PEDIDO_ATRASADO
  MERMA_EXCESIVA
  ROLLO_PERDIDO
  CONTEO_DISCREPANCIA
  RESERVA_EXPIRADA
  TRANSITO_RETRASADO
}

model Task {
  id          String     @id @default(uuid())
  alertId     String?
  titulo      String
  descripcion String?
  estado      TaskStatus @default(PENDIENTE)
  prioridad   Int        @default(3)
  asignadoA   String?    // userId
  fechaLimite DateTime?
  completadaAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  alert       Alert?     @relation(fields: [alertId], references: [id])

  @@index([estado])
  @@index([asignadoA])
}

enum TaskStatus {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
  CANCELADA
}

// =============================================================================
// GRUPO 10: AUTH + RBAC + AUDITORÍA
// =============================================================================

model User {
  id           String   @id @default(uuid())
  nombre       String
  username     String   @unique
  email        String   @unique
  password     String
  roleId       String
  activo       Boolean  @default(true)
  ultimoLogin  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role         Role     @relation(fields: [roleId], references: [id])
  movements    InventoryMovement[]
  auditLogs    AuditLog[]
  transfers    Transfer[]
  supplyPlans  SupplyPlan[] @relation("SupplyPlanCreator")

  @@index([roleId])
}

model Role {
  id          String   @id @default(uuid())
  nombre      String   @unique // "ATC", "COBRANZA", "PICKER", "CORTADOR", etc.
  descripcion String?
  nivel       Int      @default(4) // 1=Director, 2=Gerente, 3=Coordinador, 4=Operador
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model RolePermission {
  id       String @id @default(uuid())
  roleId   String
  modulo   String // "inventory", "orders", "cutting", "reception", "reservations", "transit", etc.
  accion   String // "read", "create", "update", "delete"

  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, modulo, accion])
  @@index([roleId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  accion    String   // "LOGIN", "CREATE_HU", "CUT_ROLL", "DISPATCH_ORDER", "RESERVE_STOCK"
  entidad   String   // "HandlingUnit", "Order", "CutOperation", "Reservation"
  entidadId String?
  detalle   Json?
  ip        String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([accion])
  @@index([createdAt])
}

// =============================================================================
// GRUPO 11: CONFIGURACIÓN DEL SISTEMA
// =============================================================================

model SystemSetting {
  id        String   @id @default(uuid())
  clave     String   @unique // "smtp_host", "smtp_port", "empresa_nombre"
  valor     String
  tipo      String   @default("string") // "string", "number", "boolean", "json"
  grupo     String   @default("general") // "general", "smtp", "integracion"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// GRUPO 13: TRANSFERENCIAS ENTRE ALMACENES
// =============================================================================

model Transfer {
  id                 String         @id @default(uuid())
  codigo             String         @unique  // TRF-2026-0001
  warehouseOrigenId  String
  warehouseDestinoId String
  estado             TransferStatus @default(PENDIENTE)
  motivo             String?        // "Asignación cliente Liverpool"
  notas              String?
  creadoPor          String         // userId
  ejecutadoPor       String?        // userId que ejecutó
  fechaEjecucion     DateTime?
  fechaRecepcion     DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  warehouseOrigen    Warehouse      @relation("TransferOrigen", fields: [warehouseOrigenId], references: [id])
  warehouseDestino   Warehouse      @relation("TransferDestino", fields: [warehouseDestinoId], references: [id])
  user               User           @relation(fields: [creadoPor], references: [id])
  lineas             TransferLine[]

  @@index([warehouseOrigenId])
  @@index([warehouseDestinoId])
  @@index([estado])
  @@index([createdAt])
}

model TransferLine {
  id           String   @id @default(uuid())
  transferId   String
  huId         String
  codigoHu     String   // Snapshot del código HU al transferir
  skuNombre    String?  // Snapshot del nombre SKU
  metraje      Float    // Metraje del HU al momento de transferir
  tipoRollo    String?  // ENTERO | RETAZO
  notas        String?
  createdAt    DateTime @default(now())

  transfer     Transfer      @relation(fields: [transferId], references: [id], onDelete: Cascade)
  hu           HandlingUnit  @relation(fields: [huId], references: [id])

  @@index([transferId])
  @@index([huId])
}

enum TransferStatus {
  PENDIENTE
  EN_TRANSITO
  COMPLETADA
  CANCELADA
}

// =============================================================================
// GRUPO 12: INTEGRACIÓN (Fase 2 — CONTPAQi Cloud)
// =============================================================================

model IntegrationConfig {
  id        String   @id @default(uuid())
  nombre    String   // "CONTPAQi Cloud"
  tipo      String   // "CONTPAQI_CLOUD"
  config    Json     // { apiUrl, apiKey, companyId, ... }
  activo    Boolean  @default(false)
  ultimaSync DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SyncLog {
  id            String   @id @default(uuid())
  integracionId String
  direccion     String   // "IN" (ERP→WMS) o "OUT" (WMS→ERP)
  entidad       String   // "Order", "Invoice", "Product"
  entidadId     String?
  estado        String   // "SUCCESS", "ERROR", "PARTIAL"
  detalle       Json?
  createdAt     DateTime @default(now())

  @@index([integracionId])
  @@index([estado])
  @@index([createdAt])
}

// =============================================================================
// GRUPO 13: PLANIFICACIÓN DE ABASTECIMIENTO
// =============================================================================

model SupplyPlan {
  id              String   @id @default(uuid())
  mes             Int      // 1-12
  anio            Int      // 2026
  estado          String   @default("BORRADOR") // BORRADOR | APROBADO | EN_EJECUCION | CERRADO
  notas           String?
  totalEstimado   Decimal? @db.Decimal(12, 2)
  creadoPor       String
  aprobadoPor     String?
  fechaAprobacion DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lineas          SupplyPlanLine[]
  user            User     @relation("SupplyPlanCreator", fields: [creadoPor], references: [id])

  @@unique([mes, anio])
}

model SupplyPlanLine {
  id                String   @id @default(uuid())
  planId            String
  skuId             String

  stockActual       Float
  transitoActual    Float
  demandaProyectada Float
  consumoPromedio   Float

  stockMinimo       Float    @default(0)
  diasCobertura     Float
  necesidadNeta     Float

  // === MOTOR RESURTIDO FORMATEX ===
  promedio4M        Float?   // 4M Prom Vta (m/mes)
  proyeccion4M5     Float?   // Proy. Prom. Vta = 4M Prom * 4.5
  decisionStatus    String?  @default("OK") // "OK" | "RESURTIR"
  ajusteDireccion   Float?   // Ajuste Final Ricardo (decisión directiva)

  cantidadSugerida  Float    @default(0)
  cantidadAprobada  Float?
  supplierId        String?
  precioEstimado    Decimal? @db.Decimal(10, 2)
  prioridad         String   @default("MEDIA") // CRITICA | ALTA | MEDIA | BAJA
  status            String   @default("PENDIENTE") // PENDIENTE | APROBADO | ORDENADO | RECIBIDO

  shipmentId        String?
  notas             String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  plan              SupplyPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  sku               SkuMaster     @relation(fields: [skuId], references: [id])
  supplier          Supplier?     @relation(fields: [supplierId], references: [id])

  @@unique([planId, skuId])
  @@index([planId])
  @@index([skuId])
  @@index([prioridad])
  @@index([decisionStatus])
}

// =============================================================================
// HISTÓRICO DE FACTURACIÓN Y VENTAS (Ingesta CFDI XML / CONTPAQi)
// =============================================================================

model SkuSalesHistory {
  id             String   @id @default(uuid())
  skuId          String
  mes            Int      // 1-12
  anio           Int      // 2025, 2026
  metrosVendidos Float
  importeTotal   Decimal? @db.Decimal(12, 2)
  numFacturas    Int      @default(1)
  origen         String   @default("XML_CFDI") // "XML_CFDI" | "MANUAL" | "WMS"
  almacenCodigo  String?  // "ALM 1", "ALM 9", "T&T"
  notas          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sku            SkuMaster @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([skuId, mes, anio, origen])
  @@index([skuId])
  @@index([anio, mes])
  @@index([origen])
}

model ReorderConfig {
  id              String   @id @default(uuid())
  skuId           String   @unique
  stockMinimo     Float
  stockSeguridad  Float    @default(0)
  puntoReorden    Float
  cantidadReorden Float
  leadTimeDias    Int      @default(30)
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sku             SkuMaster @relation(fields: [skuId], references: [id])
}

// =============================================================================
// GRUPO 14: LISTAS DE PRECIOS Y COMISIONES
// =============================================================================

model PriceListConfig {
  id                 String   @id @default(uuid())
  codigo             String   @unique  // "F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10"
  nombre             String   // "Casa Decoradora", "Tienda", "Tienda Especial", "Fabricante", etc.
  descripcion        String?
  comisionPct        Decimal  @db.Decimal(5, 2) @default(0) // % comisión vendedor (oculta para ATC en cotizador)
  descuentoPct       Decimal  @db.Decimal(5, 2) @default(0) // % descuento de referencia sobre precio base
  requiereAprobacion Boolean  @default(false) // True para listas especiales (ej: F3, F5, F7, F9)
  orden              Int      @default(0)
  activo             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SkuPriceList {
  id          String    @id @default(uuid())
  skuId       String
  listaCodigo String    // "F0", "F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10"
  precio      Decimal   @db.Decimal(10, 2) // Precio neto unitario por metro
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sku         SkuMaster @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([skuId, listaCodigo])
  @@index([skuId])
  @@index([listaCodigo])
}

// =============================================================================
// GRUPO 15: PAGOS PPD (Parcialidades / Diferido)
// =============================================================================

model InvoicePayment {
  id                     String   @id @default(uuid())
  orderId                String   // Factura/Order que se está pagando
  monto                  Decimal  @db.Decimal(12, 2) // Monto total de este pago
  montoAplicado          Decimal  @db.Decimal(12, 2) // Porción aplicada a ESTA factura
  formaPago              String   // Clave SAT: "03" transferencia, "01" efectivo
  referenciaPago         String?  // Referencia bancaria
  fechaPago              DateTime @default(now())

  // === COMPLEMENTO DE PAGO CFDI (tipo P) ===
  complementoFacturapiId String?  // ID del CFDI tipo P en Facturapi
  complementoUuid        String?  // UUID fiscal del complemento
  complementoStatus      String?  // "valid", "canceled"
  complementoEmitidoAt   DateTime?

  // === MULTI-FACTURA: agrupa pagos del mismo desembolso ===
  pagoGrupoId            String?  // Agrupa pagos que salieron del mismo pago del cliente

  registradoPor          String   // userId de cobranza
  notas                  String?
  evidenciaUrl           String?  // Comprobante de pago (imagen/PDF)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  order                  Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([pagoGrupoId])
  @@index([fechaPago])
}

// =============================================================================
// GRUPO 16: CRÉDITO DE CLIENTES
// =============================================================================

model ClientCreditConfig {
  id              String   @id @default(uuid())
  clientId        String   @unique

  // === CRÉDITO ===
  creditoHabilitado Boolean @default(true)
  plazoDefault    Int      @default(30)  // 30, 60, 90 días
  montoMaximo     Decimal? @db.Decimal(12, 2) // Null = sin límite (informal)

  // === DESCUENTOS PRECONFIGURADOS ===
  listaDefault    String?  // Lista de precios default: "F1", "F2", etc.
  descuentoMaximo Decimal  @db.Decimal(5, 2) @default(20) // % máximo que un vendedor puede dar

  // === BLOQUEO ===
  bloqueado       Boolean  @default(false) // Cobranza puede bloquear ventas
  motivoBloqueo   String?
  bloqueadoPor    String?
  bloqueadoAt     DateTime?

  notas           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client          Client   @relation(fields: [clientId], references: [id])
}

// =============================================================================
// GRUPO 17: PERIODOS DE COMISIONES
// =============================================================================

model CommissionPeriod {
  id              String   @id @default(uuid())
  codigo          String   @unique  // COM-2026-05-Q1 (quincena 1 mayo 2026)
  fechaInicio     DateTime
  fechaFin        DateTime
  estado          String   @default("ABIERTO") // ABIERTO, CERRADO, PAGADO
  creadoPor       String
  cerradoAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// =============================================================================
// GRUPO 18: ÓRDENES DE COMPRA (Módulo Compras)
// =============================================================================

model PurchaseOrder {
  id              String              @id @default(uuid())
  codigo          String              @unique  // OC-2026-0001
  supplierId      String
  estado          PurchaseOrderStatus @default(BORRADOR)
  prioridad       Int                 @default(3) // 1=urgente, 5=baja

  // === FECHAS ===
  fechaEmision    DateTime            @default(now())
  fechaEstimadaEntrega DateTime?
  fechaRealEntrega DateTime?

  // === FINANCIERO ===
  subtotal        Decimal?            @db.Decimal(12, 2)
  iva             Decimal?            @db.Decimal(12, 2)
  total           Decimal?            @db.Decimal(12, 2)
  condicionesPago String?             // "Crédito 30 días", "Contado"

  // === RECEPCIÓN ===
  enviadaARecepcion Boolean           @default(false)
  fechaEnvioRecepcion DateTime?
  porcentajeRecibido  Float           @default(0) // 0-100%

  // === TRAZABILIDAD ===
  supplyPlanLineId String?            // Si viene del plan de abastecimiento
  transitShipmentId String?           // IncomingShipment vinculado

  // === OPERATIVO ===
  transportista   String?
  notas           String?             // Notas que van en el PDF
  notasInternas   String?             // Notas internas (no van en PDF)
  creadoPor       String              // userId que creó la OC
  confirmadoPor   String?             // userId que confirmó/aprobó la OC
  fechaConfirmacion DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  supplier        Supplier            @relation("SupplierPurchaseOrders", fields: [supplierId], references: [id])
  lineas          PurchaseOrderLine[]
  receipts        PurchaseOrderReceipt[]

  @@index([supplierId])
  @@index([estado])
  @@index([fechaEmision])
  @@index([prioridad])
}

model PurchaseOrderLine {
  id              String   @id @default(uuid())
  purchaseOrderId String
  skuId           String

  // === CANTIDADES ===
  cantidadRollos  Int?              // Opción 1: compra por rollos enteros
  metrajePorRollo Float?            @default(50)
  metrajeTotal    Float             // Total metros solicitados

  // === PRECIO ===
  precioUnitario  Decimal  @db.Decimal(10, 2) // Precio por metro
  importe         Decimal  @db.Decimal(12, 2) // metrajeTotal * precioUnitario
  precioFuente    String?  // PRECIO_PROVEEDOR | ULTIMA_COMPRA | PRECIO_REFERENCIA | MANUAL

  // === RECEPCIÓN PARCIAL ===
  metrajeRecibido Float    @default(0)
  rollosRecibidos Int      @default(0)

  notas           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  sku             SkuMaster     @relation("SkuPurchaseOrderLines", fields: [skuId], references: [id])

  @@index([purchaseOrderId])
  @@index([skuId])
}

// Precios negociados por Proveedor+SKU (auto-fill inteligente)
model SupplierPrice {
  id              String   @id @default(uuid())
  supplierId      String
  skuId           String
  precioUnitario  Decimal  @db.Decimal(10, 2) // Precio por metro
  vigenciaDesde   DateTime @default(now())
  vigenciaHasta   DateTime?
  notas           String?
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier        Supplier  @relation("SupplierPrices", fields: [supplierId], references: [id])
  sku             SkuMaster @relation("SkuSupplierPrices", fields: [skuId], references: [id])

  @@unique([supplierId, skuId])
  @@index([supplierId])
  @@index([skuId])
}

// Registro de recepciones parciales/totales de OC
model PurchaseOrderReceipt {
  id              String   @id @default(uuid())
  purchaseOrderId String
  receiptId       String?  // PurchaseReceipt vinculado (recepción física)

  metrajeRecibido Float
  rollosRecibidos Int
  notas           String?
  recibidoPor     String   // userId
  fechaRecepcion  DateTime @default(now())
  createdAt       DateTime @default(now())

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseOrderId])
}

enum PurchaseOrderStatus {
  BORRADOR
  CONFIRMADA
  ENVIADA_PROVEEDOR
  EN_TRANSITO
  EN_RECEPCION
  PARCIAL
  COMPLETADA
  CANCELADA
}
